# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.

# Required for AI intent parsing + summaries. Without it the app still works using rule-based fallbacks.
GEMINI_API_KEY=your-key-here

# Optional: try this Gemini model first (the app falls back through a built-in chain).
# GEMINI_MODEL=gemini-3.5-flash-lite

# Optional, demo only: allow crawling the local prompt-injection test pages at
# http://127.0.0.1:<APP_PORT>/testpages/ . Off unless set to 1. Nothing else on localhost is allowed.
# ALLOW_TESTPAGES=1
# APP_PORT=8000
